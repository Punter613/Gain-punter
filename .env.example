PORT=4000
NODE_ENV=production
CORS_ORIGIN=https://your-frontend-domain.com
REQUEST_TIMEOUT_MS=30000

GROQ_API_KEY=your_groq_api_key_here
# Optional cross-provider fallback. Retryable Groq failures (rate limits, timeouts,
# capacity/5xx errors) fall back to Gemini when this key is configured.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_FALLBACK_MODEL=gemini-3.6-flash

STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
# db.js also accepts SUPABASE_KEY or SUPABASE_ANON_KEY as fallbacks, in that order

AI_URL=
REDIS_URL=

DEFAULT_LABOR_RATE=65
TAX_RATE=0.07
SHOP_SUPPLIES_RATE=0.07

INTEL_ENABLED=true
CHARM_ENABLED=false
LIVE_SEARCH_ENABLED=false
STRIPE_ENABLED=false
