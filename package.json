{
  "name": "skskprotech-rebuild",
  "version": "1.0.0",
  "description": "SKSK ProTech - Rebuilt scaffold (backend + PWA)",
  "main": "api/server.js",
  "scripts": {
    "start": "node api/server.js",
    "dev": "nodemon api/server.js",
    "render:preview": "node scripts/bump-render-preview-trigger.js",
    "lint": "echo \"no linter configured\"",
    "test": "echo \"no tests configured\"",
    "test:guards": "node --test tests/completed.work.guard.edge-cases.test.js tests/diagnostic.stage.guard.edge-cases.test.js",
    "test:providers": "node --test tests/diagnose.schema.parity.test.js tests/provider.groq.contract.test.js tests/provider.router.fallback.test.js tests/provider.gemini.timeout.test.js tests/specialist.router.provider.test.js tests/provider.failure-boundary.test.js",
    "test:lifecycle": "node --test tests/lifecycle.http.test.js tests/test.result.placeholder.punctuation.test.js tests/diagnostic.reassessment.test.js tests/dtc.provenance.lifecycle.test.js tests/dtc.provenance.legacy-migration.test.js",
    "test:measurements": "node --test tests/measurement.normalizer.test.js tests/measurement.tag.integration.test.js",
    "test:evidence": "node --test tests/nhtsa.tsb.corpus.test.js",
    "test:quick-ask": "node scripts/test-lemon-path-resolver.js && node --test tests/quick.ask.retriever.test.js tests/quick.ask.bounded.test.js tests/quick.ask.tuned.scraper.test.js tests/quick.ask.dtc.anchor.test.js tests/lemon-targeted-evidence.scrape.test.js tests/lemon.live-latency.test.js tests/lemon.cross-context-reuse.test.js tests/manual.reuse.failclosed.test.js tests/manual.multi-dtc.probe.test.js tests/manual.dtc.semantic-handoff.test.js tests/manual.navigation.seed.test.js tests/manual.navigation.multi-dtc.test.js tests/lemon.worker.timeout.test.js tests/vin.decode.latency.test.js",
    "test:diagnose-pipeline": "node --test tests/diagnose.pipeline.contract.test.js",
    "test:evidence-packet": "node --test tests/dtc.provenance.test.js tests/diagnostic.evidence.packet.test.js tests/diagnostic.evidence.packet.route.test.js",
    "test:verified-case": "node --test tests/verified.case.handoff.test.js tests/lifecycle.http.test.js",
    "test:estimate-verified-truth": "node --test tests/estimate.verified.truth.test.js tests/verified.case.handoff.test.js tests/lifecycle.http.test.js",
    "test:repair-resolution": "node --test tests/verified.repair.resolution.test.js tests/verified.repair.resolution.edge.test.js tests/estimate.verified.truth.test.js tests/verified.case.handoff.test.js tests/lifecycle.http.test.js",
    "test:invoice-handoff": "node --test tests/verified.estimate.invoice.handoff.test.js tests/invoice.rust-adjustment.test.js tests/lifecycle.http.test.js",
    "test:frontend-lifecycle": "node --test tests/frontend.verified.lifecycle.test.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.7",
    "adm-zip": "^0.6.0",
    "axios": "^1.18.1",
    "bull": "^4.16.5",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.18.2",
    "groq-sdk": "^1.3.0",
    "jsonwebtoken": "^9.0.3",
    "node-cache": "^5.1.2",
    "stripe": "^22.3.2",
    "zod": "^3.25.76"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
